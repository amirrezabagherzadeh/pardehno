# Preferred: TMDB v4 read access token (server-only)
TMDB_READ_ACCESS_TOKEN=

# Alternative: TMDB v3 API key (server-only)
TMDB_API_KEY=

# OMDb key for verified IMDb ratings (server-only)
OMDB_API_KEY=

TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional HTTP(S) proxy for server-side TMDB and translation requests.
OUTBOUND_PROXY_URL=

# Machine-translates missing English TMDB descriptions to Persian.
PERSIAN_TRANSLATION_ENABLED=true
# Optional: raises the public translation service quota.
PERSIAN_TRANSLATION_EMAIL=
